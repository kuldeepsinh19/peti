# Copy to .env and adjust. Every variable is validated at start-up by src/config/env.ts.

# local | test | staging | production — decides whether dev tooling and the sandbox provider may run.
APP_ENV=local
APP_URL=http://localhost:3000

# Docker Compose Postgres (docker compose up -d). Integration tests use DATABASE_URL_TEST.
DATABASE_URL=postgresql://peti:peti@localhost:5432/peti
DATABASE_URL_TEST=postgresql://peti:peti@localhost:5432/peti_test

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# AUTH_TRUSTED_ORIGINS=http://localhost:3100

# Payments. "sandbox" is a local provider that signs callbacks and webhooks with the secrets below and
# is refused at start-up when APP_ENV=production. "razorpay" accepts test-mode keys (rzp_test_…) only.
PAYMENT_PROVIDER=sandbox
SANDBOX_PAYMENT_KEY_SECRET=replace-with-a-random-string
SANDBOX_PAYMENT_WEBHOOK_SECRET=replace-with-another-random-string
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Photo storage. "filesystem" writes under STORAGE_FS_ROOT; "s3" works with any S3-compatible service
# (docker compose --profile s3 up -d starts RustFS on :9000).
STORAGE_DRIVER=filesystem
STORAGE_FS_ROOT=./storage
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=ap-south-1
# S3_BUCKET=peti
# S3_ACCESS_KEY_ID=peti-local
# S3_SECRET_ACCESS_KEY=peti-local-secret
# S3_FORCE_PATH_STYLE=true

# Email and SMS. "outbox" stores messages in the database and shows them at /dev/outbox.
MAIL_DRIVER=outbox
MAIL_FROM="Peti <no-reply@peti.local>"
# SMTP_URL=smtp://user:pass@smtp.example.com:587
SMS_DRIVER=outbox

# Shared secret for POST /api/cron/sweep (required in production).
CRON_SECRET=replace-with-a-random-string
